# --- Option A: Azure OpenAI Realtime (recommended if you use Azure) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-api-key
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1-mini
AZURE_OPENAI_REALTIME_VOICE=alloy
# Chat deployment for resume analysis + hiring evaluation
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini

# --- Option B: OpenAI Realtime (direct) ---
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# OPENAI_REALTIME_VOICE=alloy

# Used for resume parsing + hiring evaluation (OpenAI Chat API)
OPENAI_API_KEY=sk-your-key-here
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
