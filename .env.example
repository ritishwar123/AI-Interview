# --- Azure OpenAI Realtime (voice interview) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-api-key
# MUST be a realtime deployment — NOT gpt-4o-mini (that is chat-only)
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-2.1-mini
AZURE_OPENAI_REALTIME_VOICE=alloy

# --- OpenAI Chat (evaluation + resume analysis only) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_FEEDBACK_MODEL=gpt-4o-mini

# Optional: only if using Azure for evaluation (separate chat deployment)
# AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
